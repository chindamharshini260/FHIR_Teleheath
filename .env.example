# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Cloud Configuration
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""

# FHIR R4 Interoperability Server Endpoint
FHIR_SERVER_URL="http://localhost:3000/api/fhir"

# AI Machine Learning Service Endpoint
AI_SERVICE_URL="http://localhost:3000/api/ai"

# WebRTC / Telehealth Video Consultation Service
VIDEO_CONSULTATION_SERVICE_URL=""

# Administrator Secret Key (used for bootstrapping administrative accounts)
ADMIN_BOOTSTRAP_KEY="admin_telehealth_secure_key_2026"

